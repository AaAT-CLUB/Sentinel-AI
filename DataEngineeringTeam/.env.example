# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel
DB_USER=postgres
DB_PASSWORD=yourpassword

# Protects POST /import-cves — set to any strong random string
API_KEY=change-me

# Optional: NVD API key (free at https://nvd.nist.gov/developers/request-an-api-key)
# Without it the NVD rate limit is 5 req/30s; with it it's 50 req/30s
NVD_API_KEY=
